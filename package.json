  "scripts": {
    "dev:client": "vite dev --port 5001",
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "deploy:smoke": "node scripts/deploy-smoke.mjs",
    "deploy:docker-smoke": "node scripts/docker-smoke.mjs",
    "smoke:assistant-r1": "node scripts/assistant-r1-smoke.mjs",
    "smoke:assistant-risk": "node scripts/assistant-risk-smoke.mjs",
    "smoke:assistant-ui": "node scripts/assistant-ui-smoke.mjs",
    "release:r1-gate": "node scripts/release-r1-gate.mjs",
    "lint": "eslint client/src/pages/mobile/ConversationHome.tsx client/src/components/mobile/conversation/ConversationHomeSections.tsx client/src/lib/assistant-api.ts",
    "check": "tsc --noEmit",
    "format:check": "git diff --check",
    "test": "npm run test:api && npm run test:unit",
    "test:run": "npm run test",
    "test:unit": "node --require ./scripts/vitest-windows-net-use-shim.cjs ./node_modules/vitest/vitest.mjs run",
    "test:api": "node --require ./scripts/vitest-windows-net-use-shim.cjs ./node_modules/vitest/vitest.mjs run --config vitest.api.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:api:health": "node --require ./scripts/vitest-windows-net-use-shim.cjs ./node_modules/vitest/vitest.mjs run --config vitest.api.health.config.ts"
  },
