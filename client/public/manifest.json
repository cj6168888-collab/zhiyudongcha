{
  "name": "领航者 (Navigator-X)",
  "short_name": "领航者",
  "description": "具备自举进化、跨端穿行、拟人操作能力的数字生命系统",
  "start_url": "/",
  "display": "standalone",
  "display_override": ["fullscreen", "standalone"],
  "background_color": "#030712",
  "theme_color": "#0891b2",
  "orientation": "portrait-primary",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "scope": "/",
  "icons": [
    {
      "src": "/favicon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "对话",
      "short_name": "对话",
      "description": "与领航者对话",
      "url": "/chat",
      "icons": [{"src": "/favicon.png", "sizes": "96x96"}]
    },
    {
      "name": "设备设置",
      "short_name": "设备",
      "description": "配置本地AI设备",
      "url": "/settings",
      "icons": [{"src": "/favicon.png", "sizes": "96x96"}]
    }
  ],
  "features": [
    "Cross-device AI synchronization",
    "Offline local inference",
    "Privacy mode",
    "Voice wake word"
  ],
  "permissions": [
    "microphone",
    "notifications",
    "background-sync"
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
}
