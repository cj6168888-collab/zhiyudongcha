# Sheng-Yu-Zhu-Shou production environment template
# Copy to .env.production and replace every placeholder before deploying.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database
POSTGRES_DB=sheng_yu_zhu_shou
POSTGRES_USER=sheng_yu_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://sheng_yu_app:replace-with-a-strong-database-password@database:5432/sheng_yu_zhu_shou
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_DB=0
REDIS_KEY_PREFIX=sheng_yu_prod:
REDIS_TTL=7200

# Security
SESSION_SECRET=replace-with-at-least-64-random-characters-session-secret
AVATAR_MASTER_SECRET=replace-with-at-least-64-random-characters-avatar-secret
MASTER_SECRET=replace-with-at-least-64-random-characters-config-secret
API_KEY=replace-with-a-random-api-key-if-api-key-middleware-is-enabled
DEV_AUTH_BYPASS=false

# Cookies and CORS
COOKIE_SECURE=true
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE=86400000
CORS_ORIGIN=https://your-domain.example
CORS_CREDENTIALS=true

# Session
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=false
SESSION_ROLLING=true

# AI providers
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
OPENAI_API_KEY=
COZE_API_KEY=
COZE_BOT_ID=
COZE_WORKFLOW_ID=

# Monitoring and limits
HELMET_ENABLED=true
MONITORING_ENABLED=true
MONITORING_INTERVAL=5000
MONITORING_ALERT_INTERVAL=10000
API_RATE_LIMIT_WINDOW=900000
API_RATE_LIMIT_MAX=1000
LOG_LEVEL=info
TIMEZONE=Asia/Shanghai
