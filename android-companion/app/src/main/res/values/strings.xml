    <!-- Permission Explanations -->
    <string name="microphone_permission_title">麦克风权限</string>
    <string name="microphone_permission_explanation">小智需要使用麦克风来监听您的语音命令，实现免唤醒持续监听功能。录音仅在本地处理，不会泄露您的隐私。</string>
    
    <string name="storage_permission_title">存储权限</string>
    <string name="storage_permission_explanation">小智需要访问存储来监控微信等应用接收的文件，方便自动整理和保护您的重要文档。</string>
    
    <string name="notification_permission_title">通知权限</string>
    <string name="notification_permission_explanation">开启通知权限后，小智可以实时获取微信、短信等重要通知，及时为您提供提醒服务。</string>
    
    <string name="battery_optimization_title">电池优化</string>
    <string name="battery_optimization_explanation">为了确保小智能在后台持续运行，请关闭电池优化限制。这不会显著增加电量消耗，但对服务稳定性很重要。</string>
    
    <string name="accessibility_title">无障碍服务</string>
    <string name="accessibility_explanation">无障碍服务允许小智自动操作手机屏幕，实现点击、滑动等自动化操作。这是实现语音控制手机的核心功能。</string>
    
    <string name="notification_listener_title">通知监听</string>
    <string name="notification_listener_explanation">通知监听允许小智读取手机通知内容，实现微信消息、验证码等自动识别功能。</string>
    
    <string name="permission_denied_message">您拒绝了一些权限，这可能导致部分功能无法正常使用。</string>
    
